# =========================================================
# DXM local-development and security exclusions
# =========================================================

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Dependencies
/vendor/
/node_modules/

# Laravel runtime
/storage/app/*
!/storage/app/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore

# Public storage symlink/uploads
/public/storage

# Local databases and dumps
/database/*.sqlite
*.sql
*.sql.gz
*.dump

# Local backups, patches and archives
/backups/
/backup_*/
/.patch_backups/
*.tar
*.tar.gz
*.zip
*.bak
*.backup
*.before_*
*.bak_*

# Tool and operating-system residue
.phpunit.result.cache
.DS_Store
Thumbs.db

# AppsHub runtime and historical storage
/storage/backups/
/storage/dxm_sql/
/storage/*.sql
/storage/**/*.sql

# Historical source copies
*.bak
*.bak-*
*.bak_*
*.before_*
*.save
*.broken_*
*.backup-before-*
